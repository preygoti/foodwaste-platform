# Database Connection (Optional for local SQLite; automatically uses SQLite if unset)
DATABASE_URL=sqlite:///./foodwaste.db
# For Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/foodwaste

# JWT Signing Secret (Set to a secure random string in production)
JWT_SECRET=dev-secret-change-in-production

# Environment Mode (production | staging | development)
# Set to 'production' on Render to enforce strict JWT_SECRET and DATABASE_URL requirements
ENVIRONMENT=development

# Allowed Origins for CORS (comma-separated list of approved frontend origins)
# In production, foodwaste-platform.vercel.app and foodwaste-platform.onrender.com are included by default.
# Add any preview or custom domains here (e.g. Vercel preview URLs):
ALLOWED_ORIGINS=https://foodwaste-platform.vercel.app,http://localhost:5173

# Resend Email Delivery API (Production OTP Email Service on Render)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_123456789
EMAILS_FROM=Harvest Ledger <onboarding@resend.dev>

# Distributed Multi-Instance Rate Limiting (Optional before scaling horizontally; falls back to in-memory if unset)
# Example: Upstash Redis, Redis Cloud, or managed Redis
# REDIS_URL=redis://default:password@redis-host:6379/0

