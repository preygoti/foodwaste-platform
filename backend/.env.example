# Database Connection (Optional for local SQLite; automatically uses SQLite if unset)
DATABASE_URL=sqlite:///./foodwaste.db
# For Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/foodwaste

# JWT Signing Secret (Set to a secure random string in production)
JWT_SECRET=dev-secret-change-in-production

# Frontend Origin for CORS
FRONTEND_URL=https://foodwaste-platform.vercel.app

# Optional Email SMTP Settings (For production password reset OTP delivery)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-smtp-app-password
# EMAILS_FROM=no-reply@harvestledger.org
